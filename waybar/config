{
    "layer": "top",
    "spacing": 0,
    "height": 0,

    "margin-top": 8,
    "margin-right": 8,
    "margin-bottom": 0,
    "margin-left": 8,

    "modules-left": [
        "custom/updates",
        "hyprland/workspaces",
        "temperature",
        "memory"
    ],

    "modules-center": [
//        "custom/snip",
        "clock"
    ],

    "modules-right": [
//        "tray",
//        "disk",
//        "cpu",
//        "custom/uptime",
        "network",
        "pulseaudio",
        "battery",
//        "custom/playerctl",
        "custom/swaync",
        "custom/powermenu"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "tooltip": false,
        "format": " {name}: {icon}",
        "format-icons": {
		"active": "◉",
		"default": "○"
                },
        "max-length": 25
    },

    "tray": {
        "spacing": 10,
        "tooltip": false
    },

    "clock": {
	    "format": "{:%d/%m/%Y - %H:%M}  ",
	    "interval": 300,
        "format-alt": "{:%A, %d/%m/%Y - %H:%M}  ",
	    "tooltip-format": "<tt><small>{calendar}</small></tt>",
	    "calendar": {
		"mode"          : "year",
		"mode-mon-col"  : 3,
		"weeks-pos"     : "right",
		"on-scroll"     : 1,
		"on-click-right": "mode",
		"format": {
			"months":     "<span color='#ffead3'><b>{}</b></span>",
			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		}
	    },
	    "actions": {
	    	"on-click-right": "mode",
	    	"on-click-forward": "tz_up",
	    	"on-click-backward": "tz_down",
	    	"on-scroll-up": "shift_up",
	    	"on-scroll-down": "shift_down"
	    }
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/",
        "on-click": "kitty -e gdu /"
    },

    "cpu": {
        "format-critical": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% ",
        "interval": 2,
	    "format": "",
	    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "states": {
            "critical": 50
        }
    },

    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 35,
        "format-critical": "{icon} {temperatureC}°C",
        "format": "",
        "format-icons": ["", "", ""]
    },

    "memory": {
        "format": "",
        "format-critical": "{percentage}%",
        "interval": 2,
        "states": {
            "critical": 50
        }
    },

    "custom/uptime": {
        "format": "󰔟 {} ",
        "exec": "uptime -p | sed 's/up //; s/ d/d/; s/ h/h/; s/ m/m/'",
        "interval": 60
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""],
        "max-length": 25,
        "interval": 20,
        "states": {
            "warning": 30,
            "critical": 10
        },
        "tooltip": true,
        "tooltip-format": "{time}"
    },

    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%)  ",
        "format-ethernet": "Connected  ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "on-click": "nm-connection-editor",
        "tooltip": false,
	    "max-length": 50
    },

    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 150,
        "format": "{volume}% {icon}",
        "format-icons": ["", "", ""],
        "nospacing": 1,
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "custom/updates": {
        "format": "󰚰 {}",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "exec": "checkupdates | wc -l",
        "interval": 3600,
        "on-click": "kitty -e yay -Syu && notify-send 'System update complete.'",
        "signal": 8
    },
    "custom/snip":{
        "format": "  ",
        "on-click": "grimshot --notify save area /home/anon/Pictures/$(zenity --entry --text 'Set filename:' --entry-text '.png')"
    },
    "custom/powermenu": {
            "tooltip": false,
            "format": "  ",
            "on-click": "./.config/rofi/powermenu.sh"
    },

    "custom/swaync": {
        "format": "",
        "on-click": "swaync-client -t",
        "tooltip": false
    }
}
